{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "postgres": {
    "connectionString": "Host=localhost;Port=5432;Database=siudenretail;Username=postgres;Password=<set-locally>;CommandTimeout=120;Include Error Detail=true;"
  },
  "Jwt": {
    "Key": "<set-via-user-secrets-or-Jwt__Key-environment-variable>",
    "Issuer": "SiudenRetail",
    "Audience": "SiudenRetail_Frontend",
    "AccessTokenExpireMinutes": 15,
    "RefreshTokenIdleExpireDays": 7,
    "RefreshSessionAbsoluteExpireDays": 30,
    "RefreshTokenReuseGraceSeconds": 10
  }
}
